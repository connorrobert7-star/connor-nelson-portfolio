# Copy to .env.local and fill in. .env.local is gitignored -- keep it that way.
# Nothing in this file with "SERVICE_ROLE" or "API_KEY" in the name may ever
# reach the Expo bundle. Only the EXPO_PUBLIC_* vars are safe on a device.

# --- Supabase --------------------------------------------------------------
# Dashboard -> Project Settings -> Data API
SUPABASE_URL=https://your-project-ref.supabase.co

# Dashboard -> Project Settings -> API Keys -> anon / public.
# Safe to ship in the client: RLS is what actually protects the data, and no
# policy grants the anon role anything (see migration 0012).
SUPABASE_ANON_KEY=

# Dashboard -> Project Settings -> API Keys -> service_role.
# Bypasses RLS. Server-side only: the seed script and Edge Functions. If this
# ever lands in the Expo bundle, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (Phase 2) ---------------------------------------------------
# console.anthropic.com -> API Keys. Server-side only, called from an Edge
# Function. Never from the client.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Instacart (Phase 3) ---------------------------------------------------
# platform.instacart.com -> Developer Platform -> API keys.
# A key may be scoped to a single endpoint: a 401/403 from /products/recipe is
# usually scope, not a bad key.
INSTACART_API_KEY=
INSTACART_BASE_URL=https://connect.dev.instacart.tools

# --- Cron (Phase 6) --------------------------------------------------------
# Shared secret your VPS cron job sends so /daily-digest can reject the internet.
# Generate with: openssl rand -hex 32
CRON_SHARED_SECRET=

# --- Expo client (Phase 7) -------------------------------------------------
# EXPO_PUBLIC_* is inlined into the app bundle and is readable by anyone with
# the app. Only ever put the anon key here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
