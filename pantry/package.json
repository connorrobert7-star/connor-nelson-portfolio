{
  "name": "pantry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pantry-aware personal grocery agent",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "seed:dry": "tsx scripts/seed.ts --dry-run",
    "seed:sql": "tsx scripts/seed.ts --emit-sql supabase/seed.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "@supabase/supabase-js": "^2.99.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
